# ── Contract (update after deploying with `npm run deploy` in /contracts) ──
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# ── Ritual Chain ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=1979
NEXT_PUBLIC_RPC_URL=https://rpc.ritualfoundation.org

# ── WalletConnect (get your project ID from https://cloud.walletconnect.com) ─
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
